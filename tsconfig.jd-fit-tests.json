{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".jd-fit-test-build",
    "rootDir": ".",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["app/lib/jdFit/**/*.ts", "app/api/jd-fit/**/*.ts"]
}
