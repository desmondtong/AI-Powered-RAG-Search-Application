{
  "name": "rag-search-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:experience": "rm -rf .experience-test-build && tsc -p tsconfig.experience-tests.json && node --test .experience-test-build/app/lib/experience/*.test.js",
    "test:jd-fit": "rm -rf .jd-fit-test-build && tsc -p tsconfig.jd-fit-tests.json && node --test \".jd-fit-test-build/app/lib/jdFit/**/*.test.js\"",
    "build:rag-eval": "rm -rf .rag-eval-test-build && tsc -p tsconfig.rag-eval-tests.json",
    "test:rag-eval": "npm run build:rag-eval && node --test \".rag-eval-test-build/app/lib/ragQualityEvals/**/*.test.js\"",
    "eval:rag": "npm run build:rag-eval && node .rag-eval-test-build/app/lib/ragQualityEvals/cli/offline.js",
    "eval:rag:live": "npm run build:rag-eval && node --env-file-if-exists=.env.local .rag-eval-test-build/app/lib/ragQualityEvals/cli/live.js",
    "rag-eval:corpus": "npm run build:rag-eval && node --env-file-if-exists=.env.local .rag-eval-test-build/app/lib/ragQualityEvals/cli/corpus.js"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "^2.118.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "pdf2json": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
