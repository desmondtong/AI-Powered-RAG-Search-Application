{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".experience-test-build",
    "rootDir": ".",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "app/lib/documentExtraction.ts",
    "app/lib/experience/**/*.ts",
    "app/api/upload/route.ts",
    "app/api/experiences/**/*.ts"
  ]
}
